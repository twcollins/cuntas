POSTGRES_PASSWORD=change-me-owner
APP_DB_PASSWORD=change-me-app
# 32 random bytes, base64: openssl rand -base64 32
CUNTAS_KEK=
WEB_ORIGIN=http://localhost:8080
API_ORIGIN=http://localhost:8787
# mock | enablebanking
BANK_PROVIDER=mock
ENABLE_BANKING_APP_ID=
# PEM with \n escapes
ENABLE_BANKING_PRIVATE_KEY=
# Optional Ed25519 PEM to sign the rule-pack manifest
RULES_SIGNING_KEY=
# Host port for the web app
WEB_PORT=8080
# For the native apps: allow their origins and send cookies cross-site (needs HTTPS)
EXTRA_ORIGINS=
# EXTRA_ORIGINS=capacitor://localhost,https://localhost
CROSS_SITE_COOKIES=0
