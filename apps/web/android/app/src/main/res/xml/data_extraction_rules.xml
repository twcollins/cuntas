<?xml version="1.0" encoding="utf-8"?>
<!-- The database key lives in the Android Keystore and never leaves the phone, so a restored copy
     of the database could not be opened. Keep it out of cloud backup and device transfer; the app
     asks for an encrypted backup file instead. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
